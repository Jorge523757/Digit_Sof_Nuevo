# CONFIGURACIÓN DE VARIABLES DE ENTORNO - DIGITSOFT
# ============================================================================
# Copia este archivo como ".env" y completa los valores reales
# NUNCA subas el archivo .env a Git (ya está en .gitignore)
# ============================================================================

# ============================================================================
# CONFIGURACIÓN DE EMAIL (GMAIL) - Para recuperación de contraseña rápida
# ============================================================================

# Backend de email
# - Producción: django.core.mail.backends.smtp.EmailBackend (envío real)
# - Desarrollo: django.core.mail.backends.console.EmailBackend (solo consola)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# Configuración SMTP de Gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True

# Tu cuenta de Gmail y contraseña de aplicación
# IMPORTANTE: NO uses tu contraseña normal de Gmail
# Debes generar una "Contraseña de Aplicación" siguiendo estos pasos:
EMAIL_HOST_USER=tu_email@gmail.com
EMAIL_HOST_PASSWORD=tu_contraseña_de_aplicacion_aqui

# Email que aparecerá como remitente
DEFAULT_FROM_EMAIL=DIGIT SOFT <tu_email@gmail.com>

# Email del administrador
ADMIN_EMAIL=tu_email@gmail.com

# URL del sitio (para enlaces en emails)
SITE_URL=http://localhost:8000

# ============================================================================
# CÓMO GENERAR UNA CONTRASEÑA DE APLICACIÓN EN GMAIL:
# ============================================================================
# 1. Ve a tu cuenta de Google: https://myaccount.google.com/
# 2. Activa la verificación en dos pasos (si no la tienes)
# 3. Ve a: https://myaccount.google.com/apppasswords
# 4. Selecciona "Correo" y "Windows Computer" (o el dispositivo que uses)
# 5. Haz clic en "Generar"
# 6. Copia la contraseña de 16 caracteres (sin espacios)
# 7. Pégala en EMAIL_HOST_PASSWORD arriba
# ============================================================================

# ============================================================================
# OTRAS CONFIGURACIONES
# ============================================================================

# Modo debug (True en desarrollo, False en producción)
DEBUG=True

# Clave secreta de Django (genera una única para producción)
SECRET_KEY=django-insecure-digt-soft-2024-cambiar-en-produccion

# Base de datos (opcional, por defecto usa SQLite)
# DATABASE_URL=postgresql://usuario:password@localhost/digitsoft

